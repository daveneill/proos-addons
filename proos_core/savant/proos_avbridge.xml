<?xml version="1.0" encoding="UTF-8"?>
<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="racepoint_component_profile.xsd" manufacturer="ProOS" model="AVBridge" alias="ProOS AV Bridge 2.0"
  device_class="Lighting_controller" minimum_component_engine_version="0" rpm_xml_version="2.7">

  <notes>
    ProOS AV Bridge 2.0 (28 September 2026). Written to Savant's Component Profile
    Developer's Guide (Parts 1 and 2): an IP device the host connects OUT to. The
    device is the ProOS box itself. Nothing is installed on the Savant host.

    Set the IP address on the wire to the PROOS BOX (Pro shows it on Systems > Savant).
    Port 25804. Switch the feed on in Pro; this component's rows go green there.

    What ProOS sends, one line each, on connect (the snapshot) and on every change:
      ACT|room|verdict   -> Activity_room        (watch_apple_tv, watch_shield,
                                                   watch_tv, off; music rooms: on,
                                                   playing, idle, paused)
                            IsRoomOn_room        true unless off / empty
      DSP|room|on|off    -> TVPowerStatus_room   ON / OFF
                            IsTVOn_room          true / false
      HELLO|proos|ver    -> CoreVersion
      PONG               -> BridgeAlive true     (answer to the 30 s Ping)
    "room" is the room's id as ProOS publishes it: lower case, spaces as
    underscores (living_room, becs_office). Pro lists every room on the page.

    What Savant sends: Ping (scheduled, every 30 s) and ReportZone(Zone, Key,
    Value) — call it from a Blueprint state trigger to tell ProOS what a zone is
    doing (e.g. Zone=Living Room, Key=service, Value=SVC_AV_TV). ProOS mirrors
    it as its own Savant sensor so its awareness includes the Savant remotes.

    Placed as a Lighting controller resource so that Blueprint places it; it
    exposes no lighting. Wire nothing to it but state triggers.
  </notes>

  <control_interfaces preferred="ip">
    <ip port="25804" response_time_length_ms="5000" protocol="tcp">
      <send_postfix type="hex">0A</send_postfix>
      <receive_end_condition test_condition="data" type="hex">0A</receive_end_condition>
    </ip>
  </control_interfaces>

  <media_interfaces>
    <data name_on_component="Ethernet">
      <combined_media>
        <data_media type="ethernet"/>
        <control port="25804"/>
      </combined_media>
    </data>
    <internal name_on_component="ProOS">
      <environmental_media/>
      <resource resource_type="ENV_LIGHTINGCONTROLLER_SOURCE"/>
    </internal>
  </media_interfaces>

  <state_variable_list>
    <state_variable name="bridge_version" owning_logical_component="ProOS" state_center_type="string" note="ProOS AV Bridge profile version">2.0</state_variable>
    <state_variable name="CoreVersion" owning_logical_component="ProOS" state_center_type="string" note="ProOS Core version, from HELLO"></state_variable>
  </state_variable_list>

  <logical_component logical_component_name="ProOS">
    <implementation>
      <internal name_on_component="ProOS"/>
    </implementation>

    <status_messages>
      <!-- HELLO|proos|<core version> : first line on every connection -->
      <status_message name="Hello">
        <constant type="character">HELLO|proos|</constant>
        <data type="character" terminator_type="end_of_data">
          <update state="CoreVersion" type="string"/>
        </data>
      </status_message>

      <!-- ACT|<room>|<verdict> : the room's activity verdict -->
      <status_message name="Activity">
        <constant type="character">ACT|</constant>
        <data type="character" terminator="|" terminator_type="character">
          <update state="Room" type="string"/>
        </data>
        <data type="character" terminator_type="end_of_data">
          <update state="Activity" type="string"/>
          <data_map match_required="no">
            <map key="off"><update state="IsRoomOn" type="boolean">false</update></map>
            <map key=""><update state="IsRoomOn" type="boolean">false</update></map>
            <map key="watch_apple_tv"><update state="IsRoomOn" type="boolean">true</update></map>
            <map key="watch_shield"><update state="IsRoomOn" type="boolean">true</update></map>
            <map key="watch_tv"><update state="IsRoomOn" type="boolean">true</update></map>
            <map key="on"><update state="IsRoomOn" type="boolean">true</update></map>
            <map key="playing"><update state="IsRoomOn" type="boolean">true</update></map>
            <map key="paused"><update state="IsRoomOn" type="boolean">true</update></map>
            <map key="idle"><update state="IsRoomOn" type="boolean">true</update></map>
          </data_map>
        </data>
        <append_data_to_state_names state="Room"/>
      </status_message>

      <!-- DSP|<room>|on|off : the room's display -->
      <status_message name="Display">
        <constant type="character">DSP|</constant>
        <data type="character" terminator="|" terminator_type="character">
          <update state="Room" type="string"/>
        </data>
        <data type="character" terminator_type="end_of_data">
          <update state="DisplayState" type="string"/>
          <data_map match_required="no">
            <map key="on">
              <update state="TVPowerStatus" type="string">ON</update>
              <update state="IsTVOn" type="boolean">true</update>
            </map>
            <map key="off">
              <update state="TVPowerStatus" type="string">OFF</update>
              <update state="IsTVOn" type="boolean">false</update>
            </map>
          </data_map>
        </data>
        <append_data_to_state_names state="Room"/>
      </status_message>

      <!-- PONG : the answer to Ping -->
      <status_message name="Pong">
        <data type="character" terminator_type="end_of_data">
          <update state="LastLine" type="string"/>
          <data_map match_required="yes">
            <map key="PONG">
              <update state="BridgeAlive" type="boolean">true</update>
            </map>
          </data_map>
        </data>
      </status_message>
    </status_messages>

    <custom_component_actions>
      <!-- Ping : every 30 s, so Savant's own watchdog sees a live device -->
      <action name="Ping">
        <command_interface interface="ip">
          <command response_required="no">
            <command_string type="character">PING</command_string>
            <delay ms_delay="0"/>
          </command>
        </command_interface>
        <execute_on_schedule period_ms="30000"/>
      </action>

      <!-- ReportZone(Zone, Key, Value) : SAV|Zone|Key|Value — call from a state trigger -->
      <action name="ReportZone">
        <action_argument name="Zone" note="The Savant zone (room) name, e.g. Living Room"/>
        <action_argument name="Key" note="What is being reported, e.g. service, power, volume"/>
        <action_argument name="Value" note="Its value, e.g. SVC_AV_TV, on, 23"/>
        <command_interface interface="ip">
          <command response_required="no">
            <command_string type="character">SAV|</command_string>
            <parameter_list>
              <parameter parameter_data_type="character" action_argument="Zone"/>
              <parameter parameter_data_type="character">|</parameter>
              <parameter parameter_data_type="character" action_argument="Key"/>
              <parameter parameter_data_type="character">|</parameter>
              <parameter parameter_data_type="character" action_argument="Value"/>
            </parameter_list>
            <delay ms_delay="0"/>
          </command>
        </command_interface>
      </action>
    </custom_component_actions>
  </logical_component>

</component>
