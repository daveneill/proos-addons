{
  "name": "ProOS AI Assistant",
  "version": "1.0.0",
  "slug": "proos_mcp",
  "description": "AI assistant MCP server for ProOS smart home dashboard",
  "url": "https://github.com/your-org/proos-addon",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "startup": "application",
  "boot": "auto",
  "ports": {
    "3000/tcp": 3000
  },
  "ports_description": {
    "3000/tcp": "ProOS MCP Server"
  },
  "options": {
    "anthropic_api_key": "",
    "allowed_origins": "*",
    "log_level": "info"
  },
  "schema": {
    "anthropic_api_key": "str",
    "allowed_origins": "str",
    "log_level": "list(debug|info|warning|error)"
  },
  "hassio_api": true,
  "homeassistant_api": true,
  "auth_api": true,
  "ingress": false,
  "panel_icon": "mdi:brain",
  "map": ["config:rw"],
  "environment": {
    "NODE_ENV": "production"
  }
}
